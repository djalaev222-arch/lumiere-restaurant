DATABASE_URL="file:./dev.db"
PORT=4310
CORS_ORIGIN="http://127.0.0.1:5199"
JWT_SECRET="replace-with-a-long-random-string"

# Optional — leave unset to keep online payment in demo/mock mode (order is
# accepted immediately, no real charge). Get test credentials at
# https://yookassa.ru/developers/using-api/testing (no legal entity required
# to test) and the real ones once you're ready to accept live payments.
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
YOOKASSA_RETURN_URL="http://127.0.0.1:5199/delivery/payment-result"

# Optional — leave unset to log notifications to the console instead of
# sending them (dev-friendly, nothing breaks). Any SMTP provider works
# (Gmail app password, Yandex почта, Mailgun, etc.).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Lumière <no-reply@lumiere-restaurant.ru>"

# Optional — restaurant-side alerts for new bookings/orders. Create a bot via
# @BotFather in Telegram (takes a minute, free), then message your new bot
# once and open https://api.telegram.org/bot<TOKEN>/getUpdates to read your
# chat id from the response.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
